# Copy to .env for local work. On Railway, put these in the service's Variables tab instead.

# ---- who may call this API (the website's address, no path, no trailing slash; comma-separate several)
ALLOWED_ORIGINS=https://yourname.github.io

# ---- signing key for login tokens / sign-in challenges / file links. Keep it secret and stable.
SECRET_KEY=

# ---- 1 = demo mode: codes are NOT sent; each code is printed in the server log instead (your terminal locally,
#      Railway > service > Logs) as '[BhumiSetu OTP] email -> you@example.com : 123456'. It is never shown in the
#      browser. Local test sites (localhost:8000 etc.) may also call the API. MUST be 0 when real people use it.
OTP_DEV_MODE=0

# ---- first Sub-Registrar(s) without a shell: people who signed up and verified THAT email/mobile are promoted.
#      Format:  contact|office|pin codes ; contact|office|pin codes      (pin codes: 411001-411010, 4120*, or *)
# REGISTRAR_BOOTSTRAP=officer@example.com|Haveli Sub-Registrar Office|411001-411010

# ---- where data lives. On Railway use a Volume mounted at /data and set:
# DATABASE_PATH=/data/bhumisetu.db
# DOC_DIR=/data/documents
# KYC_DIR=/data/kyc

# ---- one-time codes by email (free): Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- reads sale deeds automatically (optional; registrars can type the details instead)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ---- "Continue with Google" for citizens (optional): the *Web application* OAuth client ID
GOOGLE_CLIENT_ID=

# ---- SMS one-time codes through Fast2SMS (paid)
FAST2SMS_API_KEY=

# ---- optional, paid: WhatsApp through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM= 
TWILIO_WHATSAPP_FROM=

# ---- local only: HOST=0.0.0.0 lets a phone on your Wi-Fi reach the API
# HOST=127.0.0.1
# PORT=5000
